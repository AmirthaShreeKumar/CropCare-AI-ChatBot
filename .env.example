# CropCare AI Environment Configuration Example
# Copy this file to .env and fill in your actual API keys and credentials

# Gemini API Key (multimodal vision symptom extraction)
GOOGLE_API_KEY="your-gemini-api-key-here"

# Groq API Key (cognitive multi-agent reasoning)
GROQ_API_KEY="your-groq-api-key-here"

# Application Registration Shared Secret
APP_SECRET="your-shared-signup-secret-here"

# Database Configuration (for local execution)
DB_USER="postgres"
DB_PASSWORD="your-postgres-password"
DB_HOST="localhost"
DB_PORT=5432
DB_NAME="cropcare"
